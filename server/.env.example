PORT=5000
FRONTEND_URL=https://advokat-tuapse.ru
JWT_SECRET=your_super_secret_jwt_key
DATABASE_URL="file:./dev.db"

# Данные для входа в админ-панель
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here

# RouterAI — оптимизация текстов дел и AI-агент блога
ROUTERAI_API_KEY=

# Яндекс.Вебмастер API — переобход страниц после деплоя
# Токен: https://oauth.yandex.ru/ (scope: webmaster)
# Получить: node server/scripts/yandex-webmaster-info.cjs
YANDEX_WEBMASTER_OAUTH_TOKEN=
YANDEX_WEBMASTER_USER_ID=
YANDEX_WEBMASTER_HOST_ID=